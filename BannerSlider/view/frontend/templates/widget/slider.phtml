declare(strict_types=1);

use MageMasani\BannerSlider\Block\Widget\Slider;
use Magento\Framework\Escaper;

/** @var Slider $block */
/** @var Escaper $escaper */

$sliderId = (int) $block->getData('slider_id');
$banners = $block->getBannerCollection();
$uniqueId = 'magemasani-slider-' . $sliderId . '-' . (int) $block->getData('items_to_show') . '-' . substr(md5((string) microtime()), 0, 6);
?>
<?php if (!empty($banners) && $sliderId > 0): ?>
    <div class="magemasani-slider-wrapper" id="<?= $escaper->escapeHtmlAttr($uniqueId); ?>" style="width: 100%">
        <div class="magemasani-slider-items masani">
            <?php foreach ($banners as $banner): ?>
                <div class="slider-mage-masani-item">
                    <?php if ($banner['resource_type'] === 'local_image' || $banner['resource_type'] === 'external_image'): ?>
                        <div class="banner-image <?= $escaper->escapeHtmlAttr($banner['resource_type']); ?>">
                            <?php if (!empty($banner['link_url']) && $banner['link_url'] !== '#'): ?>
                                <a href="<?= $escaper->escapeUrl($banner['link_url']); ?>">
                                    <img src="<?= $escaper->escapeUrl($banner['resource_path']); ?>"
                                         alt="<?= $escaper->escapeHtmlAttr($banner['alt_text'] ?: $banner['title']); ?>" />
                                </a>
                            <?php else: ?>
                                <img src="<?= $escaper->escapeUrl($banner['resource_path']); ?>"
                                     alt="<?= $escaper->escapeHtmlAttr($banner['alt_text'] ?: $banner['title']); ?>" />
                            <?php endif; ?>
                        </div>
                    <?php elseif ($banner['resource_type'] === 'youtube_video'): ?>
                        <div class="banner-video <?= $escaper->escapeHtmlAttr($banner['resource_type']); ?>">
                            <iframe src="<?= $escaper->escapeUrl($banner['resource_path']); ?>"
                                    title="<?= $escaper->escapeHtmlAttr($banner['title']); ?>"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                    allowfullscreen></iframe>
                        </div>
                    <?php elseif ($banner['resource_type'] === 'custom_html'): ?>
                        <div class="banner-html <?= $escaper->escapeHtmlAttr($banner['resource_type']); ?>">
                            <div class="content-main">
                                <?= /* @noEscape */ $banner['resource_path']; ?>
                            </div>
                        </div>
                    <?php endif; ?>
                </div>
            <?php endforeach; ?>
        </div>
    </div>
    <script>
        require([
            'jquery',
            'slick'
        ], function ($) {
            var sliderContainer = $('#<?= $escaper->escapeJs($uniqueId); ?>').find('.masani');
            if (sliderContainer.length && typeof sliderContainer.slick === 'function') {
                sliderContainer.slick(<?= /* @noEscape */ $block->getSliderOptions(); ?>);
            }
        });
    </script>
<?php endif; ?>
