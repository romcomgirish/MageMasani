<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="magemasani_pushnotification_send_scheduled"
             instance="MageMasani\PushNotification\Cron\SendScheduledCampaigns"
             method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
        <job name="magemasani_pushnotification_send_birthday"
             instance="MageMasani\PushNotification\Cron\SendBirthdayCampaigns"
             method="execute">
            <schedule>5 0 * * *</schedule>
        </job>
    </group>
</config>
