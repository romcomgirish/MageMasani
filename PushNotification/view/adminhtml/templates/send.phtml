<?php
/** @var \Magento\Backend\Block\Template $block */
$postUrl = $block->getUrl('magemasani_webpush/send/post');
?>
<form action="<?= $block->escapeUrl($postUrl) ?>" method="post" enctype="multipart/form-data" class="form-inline"
    style="max-width:600px;">
    <?= $block->getBlockHtml('formkey') ?>
    <fieldset class="admin__fieldset">
        <legend class="admin__legend"><span><?= $block->escapeHtml(__('Send Push Notification')) ?></span></legend>
        <div class="admin__field">
            <label class="admin__field-label"><?= $block->escapeHtml(__('Send To')) ?></label>
            <div class="admin__field-control">
                <select name="send_to" id="send_to" class="admin__control-select">
                    <option value="all"><?= $block->escapeHtml(__('All Customers')) ?></option>
                    <option value="customer"><?= $block->escapeHtml(__('Specific Customer')) ?></option>
                </select>
            </div>
        </div>
        <div class="admin__field" id="customer_id_container" style="display: none;">
            <label class="admin__field-label"><?= $block->escapeHtml(__('Customer ID')) ?></label>
            <div class="admin__field-control">
                <input type="number" name="customer_id" id="customer_id" class="admin__control-text" />
            </div>
        </div>
        <div class="admin__field">
            <label class="admin__field-label"><?= $block->escapeHtml(__('Title')) ?></label>
            <div class="admin__field-control">
                <input type="text" name="title" class="admin__control-text" required="required" />
            </div>
        </div>
        <div class="admin__field">
            <label class="admin__field-label"><?= $block->escapeHtml(__('Body')) ?></label>
            <div class="admin__field-control">
                <textarea name="body" class="admin__control-textarea" required="required"></textarea>
            </div>
        </div>
        <div class="admin__field">
            <label class="admin__field-label"><?= $block->escapeHtml(__('Image')) ?></label>
            <div class="admin__field-control">
                <input type="file" name="image" class="admin__control-file"
                    accept="image/png,image/jpeg,image/gif,image/webp" />
                <div class="admin__field-note"><?= $block->escapeHtml(__('Optional. PNG, JPG, GIF or WebP.')) ?></div>
            </div>
        </div>
        <div class="admin__field">
            <div class="admin__field-control">
                <button type="submit" class="action-default scalable">
                    <span><?= $block->escapeHtml(__('Send Notification')) ?></span>
                </button>
            </div>
        </div>
    </fieldset>
</form>

<script>
    require(['jquery'], function ($) {
        $('#send_to').on('change', function () {
            if ($(this).val() === 'customer') {
                $('#customer_id_container').show();
                $('#customer_id').prop('required', true);
            } else {
                $('#customer_id_container').hide();
                $('#customer_id').prop('required', false).val('');
            }
        });
    });
</script>