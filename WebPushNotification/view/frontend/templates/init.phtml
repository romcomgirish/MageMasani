<?php
/**
 * @var \Magento\Framework\View\Element\Template $block
 * @var \MageMasani\WebPushNotification\ViewModel\Config $config
 */
$config = $block->getData('config');
if (!$config instanceof \MageMasani\WebPushNotification\ViewModel\Config || !$config->isEnabled()) {
    return;
}
?>
<script src="<?= $block->escapeUrl($config->getFirebaseAppUrl()) ?>" defer></script>
<script src="<?= $block->escapeUrl($config->getFirebaseMessagingUrl()) ?>" defer></script>
<script
    src="<?= $block->escapeUrl($block->getViewFileUrl('MageMasani_WebPushNotification::js/firebase-init.js')) ?>"
    data-firebase-config="<?= $block->escapeHtmlAttr($config->getFirebaseConfigJson()) ?>"
    data-vapid-key="<?= $block->escapeHtmlAttr($config->getVapidKey()) ?>"
    data-sw-url="<?= $block->escapeHtmlAttr($config->getServiceWorkerUrl()) ?>"
    data-save-token-url="<?= $block->escapeHtmlAttr($config->getSaveTokenUrl()) ?>"
    defer></script>
