type Mutation {
    savePushNotificationToken(input: SavePushNotificationTokenInput!): SavePushNotificationTokenOutput!
        @resolver(class: "MageMasani\\WebPushNotification\\Model\\Resolver\\SavePushNotificationToken")
        @doc(description: "Register an FCM push token for the current customer or guest. Used by web and mobile clients.")
}

input SavePushNotificationTokenInput {
    token: String! @doc(description: "FCM registration token returned by Firebase SDK.")
    device_type: PushNotificationDeviceTypeEnum! @doc(description: "Type of device the token belongs to.")
}

enum PushNotificationDeviceTypeEnum {
    web
    android
    ios
}

type SavePushNotificationTokenOutput {
    success: Boolean! @doc(description: "True if the token was stored successfully.")
    message: String @doc(description: "Human-readable status message; null on success.")
}
